# === DEPENDENCIES ===
# Covers root and all subfolders (client, client-next, server)
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === NEXT.JS (client) ===
client/.next/
client/out/
client/next-env.d.ts
.vercel
client/node_modules/
client/messages/REVISION_TEXTOS.md

# === BUILD OUTPUTS ===
# Vite, React legacy, and Server builds
**/dist/
**/dist-ssr/
**/build/
*.tsbuildinfo

# === UPLOADS & DATABASE (server) ===
# Ignore all uploads but keep the directory structure via .gitkeep
server/uploads/artworks/*
!server/uploads/artworks/.gitkeep
server/uploads/profiles/*
!server/uploads/profiles/.gitkeep
server/uploads/temp/*
!server/uploads/temp/.gitkeep
server/temp/
*.db
*.sqlite
*.sqlite3

# === ENVIRONMENT VARIABLES (SECURITY) ===
# Sensitive files - DO NOT COMMIT
.env
.env.local
.env.development
.env.production
.env.*.local
*.env
*.pem

# === LOGS ===
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# === IDE / OS / TEMP ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*.suo
*.tmp
*.temp
.cache/
.parcel-cache/

# === TESTING ===
**/coverage/
.nyc_output/

# === DOCUMENTATION ===
# Ignore all docs except for the specific instructions file
docs/*
!docs/OHJEET-TIEDOSTONIMET.md
!docs/SCALING.md

# Ignore temporary files
**/estructura.txt